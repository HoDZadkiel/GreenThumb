# 網站日常連線：只能放在伺服器端。db:setup-auth 產生受限帳號與 session 密鑰。
APP_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 開放既有會員使用 Email／密碼登入；帳密註冊由管理工具處理。
AUTH_PASSWORD_ENABLED=true

# Gmail SMTP 備援，測試期間預設關閉。
AUTH_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 遠端 PostgreSQL 驗證 CA；選用 PEM 或本機憑證路徑其中一個。
DATABASE_CA_CERT=
DATABASE_CA_FILE=

# 若目前資料庫在 Supabase，管理腳本仍用 Project URL 核對連線。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 相容舊設定；與上方公開金鑰擇一填寫即可。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 僅用於本機執行 db:setup-auth／db:push／db:admin，勿作為網站執行連線。
# Dashboard → Connect → Session pooler → URI，保留 [YOUR-PASSWORD] 佔位文字。
DATABASE_URL=
SUPABASE_DB_PASSWORD=
