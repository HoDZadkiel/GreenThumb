# 網站日常連線；公開金鑰可以放在前端。舊名稱 NEXT_PUBLIC_SUPABASE_ANON_KEY 仍支援。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 相容舊設定；與上方公開金鑰擇一填寫即可。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 僅用於本機執行 npm run db:push 等管理指令，不需要放到網站部署環境。
# Dashboard → Connect → Session pooler → URI，保留 [YOUR-PASSWORD] 佔位文字。
DATABASE_URL=
SUPABASE_DB_PASSWORD=
